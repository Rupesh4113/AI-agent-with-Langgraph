# ==============================================================================
# AI Research Agent Configuration
# ==============================================================================

# LLM Provider Configuration ("openai", "google", or "mock")
MODEL_PROVIDER=mock
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.2

# OpenAI API Key (Required if MODEL_PROVIDER=openai)
OPENAI_API_KEY=

# Google Gemini API Key (Required if MODEL_PROVIDER=google)
GOOGLE_API_KEY=

# Agent Parameters
MAX_RESEARCH_ITERATIONS=3
MIN_CONFIDENCE_THRESHOLD=0.80

# LangSmith Tracing & Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-research-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
